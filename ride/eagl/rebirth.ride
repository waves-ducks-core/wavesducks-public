func getAssetIsNormalKey(assetId: String) = {
  "asset_" + assetId + "_isNormal"
}

func isNormalEagle(assetId: ByteVector) = {
  let info = assetInfo(assetId).value()
  if (info.issuer == getEagleIncubatorAddress()) then {
    tryGetBooleanExternal(getEagleIncubatorAddress(), getAssetIsNormalKey(assetId.toBase58String()))
  } else if (info.issuer == getEagleBreederAddress()) then {
    tryGetBooleanExternal(getEagleBreederAddress(), getAssetIsNormalKey(assetId.toBase58String()))
  } else {
    false
  }
}

func tryGetIntegerExternal(address: Address, key: String) = {
    match getInteger(address, key) {
        case b:Int => b
        case _ => throw("TR: Value not found in sc!")
    }

}

func tryGetIntegerExternalZero(address: Address, key: String) = {
    match getInteger(address, key) {
        case b:Int => b
        case _ => 0
    }

}

let delayForHatching = 2

func checkReal(assetId: ByteVector) = {
  if (assetInfo(assetId).value().issuer == getEagleBreederAddress() || assetInfo(assetId).value().issuer ==getEagleIncubatorAddress()) then {
   assetInfo(assetId).value().issuer
  } else {
    throw("not valid NFT")
  }
}

func getRebirthPrice(assetId: ByteVector) = {
  let giantPrice = tryGetIntegerExternal(getOracle(),staticKey_eagleRebirthPrice())
  if isNormalEagle(assetId) then giantPrice else giantPrice / 2
}

func checkAdditionalPayment(payment: AttachedPayment)= {
  if isDefined(payment.assetId) then throw("RCAP: Please attach waves") else
  let feeAmount = getIntegerValue(getOracle(),staticKey_extraFee())
  if payment.amount != feeAmount then throw("RCAP: Please attach exactly "+feeAmount.toString()+" amount of wavelets") else
  [ScriptTransfer(getFeeAggregator(), feeAmount, unit)]

}

func getRandomNumber(options: Int, txId: ByteVector, hatchingFinishHeight: Int, offset: Int) = {
  let randomSeedBlock = blockInfoByHeight(hatchingFinishHeight-1).value()
  let randomHash = sha256(txId + randomSeedBlock.vrf.value())
  randomHash.toInt(offset*8) % options
}

func wasUniqueBorn(gen: String) = {
  func getEAGLStatsKey(genString: String) = {
  "stats_" + genString + "_amount"
}
  tryGetIntegerExternalZero(getEagleIncubatorAddress(),getEAGLStatsKey(gen))
}

func getRandomWin(tx: ByteVector, finishHeight: Int, blacklistCode: String) = {
  let jackpotRandom = getRandomNumber(100, tx, finishHeight, 2)
  #if (jackpotRandom == 1 && wasUniqueBorn("EDIT MEEE") < 4) then { (jackpotRandom,"jackpot") } else 
    #Every % means 10 numbers
    let n = getRandomNumber(1000, tx, finishHeight, 0)
    let baseResult = 
    if (n<40  && blacklistCode != "feli_incubator") then "feli_incubator" else
    if (n<53  && blacklistCode != "cani_perch_A") then "cani_perch_A" else
    if (n<65  && blacklistCode != "cani_perch_B") then "cani_perch_B" else
    if (n<78  && blacklistCode != "cani_perch_C") then "cani_perch_C" else
    if (n<90  && blacklistCode != "cani_perch_D") then "cani_perch_D" else
    if (n<100 && blacklistCode != "cani_incubator" ) then "cani_incubator" else
    if (n<120 && blacklistCode != "bull_incubator" ) then "bull_incubator" else
    if (n<270 && blacklistCode != "giant_incubator" ) then "giant_incubator" else
    if (n<420 && blacklistCode != "normal_incubator" ) then "normal_incubator" else
    if (n<495 && blacklistCode != "garage_A" ) then "garage_A" else
    if (n<570 && blacklistCode != "garage_B" ) then "garage_B" else
    if (n<645 && blacklistCode != "garage_C" ) then "garage_C" else
    if (n<720 && blacklistCode != "garage_D" ) then "garage_D" else
    if (n<728 && blacklistCode != "bull_ranch_A") then "bull_ranch_A" else
    if (n<735 && blacklistCode != "bull_ranch_B") then "bull_ranch_B" else
    if (n<743 && blacklistCode != "bull_ranch_C") then "bull_ranch_C" else
    if (n<750 && blacklistCode != "bull_ranch_D") then "bull_ranch_D" else
    if (n<763 && blacklistCode != "vperch_B") then "vperch_B" else
    if (n<775 && blacklistCode != "vperch_R") then "vperch_R" else
    if (n<788 && blacklistCode != "vperch_G") then "vperch_G" else
    if (n<800 && blacklistCode != "vperch_Y") then "vperch_Y" else
    if (n<850 && blacklistCode != "item!ART-MUTARIUM-G" ) then "item!ART-MUTARIUM-G" else
    if (n<900 && blacklistCode != "item!ART-MUTARIUM-D" ) then "item!ART-MUTARIUM-D" else
    if (n<940 && blacklistCode != "item!ART-FREEGENE" ) then "item!ART-FREEGENE" else
    if (n<980 && blacklistCode != "item!ART-FIXGENE" ) then "item!ART-FIXGENE" else
    "item!ART-MIRROR"
    let result = baseResult
    (n,result,jackpotRandom)
}

func getRandomReturn(tx: ByteVector, finishHeight: Int)={
  let n = getRandomNumber(2, tx, finishHeight, 1)
  if n == 1 then true else false
}

func finishRebirthInternal(initTx: String, address: String, additionalPayment: AttachedPayment,
 double: Boolean, blacklistCode: String, rescue: Boolean) = {
  let finishBlock = tryGetInteger("address_" + address + "_initTx_" + initTx + "_finishBlock")
  let status = tryGetString("address_" + address + "_initTx_" + initTx + "_status")
  strict validPayment = checkAdditionalPayment(additionalPayment)
  strict recordAction = invoke(getCouponsAddress(),"recordAction",["REBIRTHEAGLE"],[])

  if (status != "open") then {
    throw("rebirth is finished or not open")
  } else {
    if (height < finishBlock) then {
      throw("you cannot finish rebirth, yet")
    } else {

      let output = getRandomWin(initTx.fromBase58String(), finishBlock, blacklistCode)  
      let win = output._2
      let random = output._1
      let jackpotRandom = output._3

      let txId = initTx

      #TODO: change into docking
      strict result =  if (win.indexOf("garage") != unit) then {
        let color = win.takeRight(1)
        strict call = if !double then 
              strict first = invoke(getEagleStakingAddress(), "addFreePerch", [address, color,1], [])
              [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
            else
              strict first = invoke(getEagleStakingAddress(), "addFreePerch", [address, color,2], [])
                [
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result1", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_win1", win)
                ]
        call

      } else if (win.indexOf("vperch") != unit) then {
        let color = win.takeRight(1)
        strict call = if !double then 
              strict first = invoke(getVeggFarmingAddress(), "addFreePerch", [address, color,1], [])
              [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
            else
              strict first = invoke(getVeggFarmingAddress(), "addFreePerch", [address, color,2], [])
                [
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result1", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_win1", win)
                ]
        call

      } else if (win == "giant_incubator") then {
        strict call = if !double then 
            strict first =invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, false], [])
            [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
          else 
            strict first = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, false], [])
            strict second = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, true], [])
            [
              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "giant_incubator")
            ]
        call

      } else if (win == "normal_incubator") then {
        strict call = if !double then 
            strict first = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, true], [])
            [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
          else 
            strict first = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, true], [])
            strict second = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, false], [])
            [
              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "normal_incubator")
            ]
        call

      } else if (win == "feli_incubator") then {
        strict call = if !double then 
            strict first = invoke(getFelineIncubatorAddress(), "issueFree", [address, txId], [])
            [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
          else 
            strict first = invoke(getFelineIncubatorAddress(), "issueFree", [address, txId], [])
            strict second = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, true], [])
            [
              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "feli_incubator")
            ]
        call
      } else if (win == "cani_incubator") then {
        strict call = if !double then 
            strict first =invoke(getCanineIncubatorAddress(), "issueFree", [address, txId], [])
            [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
          else 
            strict first = invoke(getCanineIncubatorAddress(), "issueFree", [address, txId], [])
            strict second = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, false], [])
            [
              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "cani_incubator")
            ]
        call
      } else if (win == "bull_incubator") then {
        strict call = if !double then 
            strict first =invoke(getBullIncubatorAddress(), "issueFree", [address, txId], [])
            [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
          else 
            strict first = invoke(getBullIncubatorAddress(), "issueFree", [address, txId], [])
            strict second = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId, false], [])
            [
              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "bull_incubator")
            ]
        call
      } else if (win.indexOf("cani_perch_") != unit) then {
        let color = win.takeRight(1)
        strict call = if !double then 
              strict first = invoke(getCanineStakingAddress(), "addFreePerch", [address, color,1], [])
              [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
            else
              strict first = invoke(getCanineStakingAddress(), "addFreePerch", [address, color,2], [])
                [
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result1", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_win1", win)
                ]
        call
      } else if (win.indexOf("bull_ranch_") != unit) then {
        let color = win.takeRight(1)
        strict call = if !double then 
              strict first = invoke(getBullFarmingAddress(), "addFreePerch", [address, color,1], [])
              [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]
            else
              strict first = invoke(getBullFarmingAddress(), "addFreePerch", [address, color,2], [])
                [
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result1", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_win1", win)
                ]
        call
      }else if (win.indexOf("item") !=unit) then {
        let itemName = win.split("!")[1]
        strict call = if !double || itemName == "ART-MEDHOUSE" then 
                strict first = invoke(getItemsAddress(), "issueArtefactIndex", [itemName, address,0], [])
                [StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])]

            else 
                strict first = invoke(getItemsAddress(), "issueArtefactIndex", [itemName, address,0], [])
                strict second = invoke(getItemsAddress(), "issueArtefactIndex", [itemName, address,1], [])
                [
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
                  StringEntry("address_" + address + "_initTx_" + initTx + "_win1", win)
                ]
          call
      }else{
        throw("RFB: Some error occured, please contact the admins! "+win)
      }
      let returnToSender =  if rescue then getRandomReturn(initTx.fromBase58String(), finishBlock) else false
      let returnPayload = if returnToSender then
        let assetId = getStringValue("address_" + address + "_initTx_" + initTx + "_assetId").fromBase58String()
        let issuer = checkReal(assetId)   
        strict gen = invoke(getEagleBreederAddress(),"getGenFromName",[assetInfo(assetId).value().name],[]).exactAs[String]  
        strict call = invoke(issuer, "increaseRarity", [assetId.toBase58String(), gen], [])
        [ScriptTransfer(address.addressFromStringValue(), 1, 
        assetId)] 
      else []
      let bonusRandom = getRandomNumber(100, initTx.fromBase58String(), finishBlock, 20)
      let bonusOutput = if bonusRandom < 50 then {
        strict bonus = invoke(getItemsAddress(),"issueArtefactIndex",["ART-BBALL",address,2],[])
        [
          StringEntry("address_" + address + "_initTx_" + initTx + "_bonusItem", bonus.exactAs[String]),
          IntegerEntry("address_" + address + "_initTx_" + initTx + "_bonusRandom",bonusRandom)
        ]
      } else [
        IntegerEntry("address_" + address + "_initTx_" + initTx + "_bonusRandom",bonusRandom)
      ]
      result ++ [
        StringEntry("address_" + address + "_initTx_" + initTx + "_win", win),
        StringEntry("address_" + address + "_initTx_" + initTx + "_status", "finish"),
        IntegerEntry("address_" + address + "_initTx_" + initTx + "_random",random),
        IntegerEntry("address_" + address + "_initTx_" + initTx + "_jackpotRandom",jackpotRandom)
      ]++validPayment++returnPayload++bonusOutput
    }
  }
}

@Callable(i)
func configureOracle(oracle: String) = {
  if i.caller != this then throw("RCU: admin only") else 
  [
    StringEntry("static_oracleAddress",oracle)
  ]

}

#Payment 0 = turtle
#payment 1 = waves
#TODO: send 1/4th to fee aggregator and 3/4th to canine lock sc

@Callable(i)
func initRebirth() = {
  let pmtEagle = i.payments[0]
  let pmtPzl = i.payments[1]
  strict extra = checkAdditionalPayment(i.payments[2])

  let assetId = pmtEagle.assetId.value()
  let pzlAmount = getRebirthPrice(assetId)
  let initTx = i.transactionId.toBase58String()
  let address = i.caller.toString()
  if (pmtEagle.amount != 1) then throw("NFT is not attached") else
  if (pmtPzl.amount != pzlAmount || pmtPzl.assetId != getPzlAssetId()) then throw("Puzzle is not attached or wrong!") else
  let sendToAggreGator = pmtPzl.amount/4
  let payUserAmount = pmtPzl.amount/5
  let topup = pmtPzl.amount - sendToAggreGator - payUserAmount

  strict addMore = invoke(getEagleStakingAddress(), "addPuzzleAndStakeMore", [], [AttachedPayment(getPzlAssetId(), topup)])
  strict payUser = invoke(getEagleStakingAddress(), "topUpReward", [], [AttachedPayment(getPzlAssetId(), payUserAmount)])

   
  let issuer = checkReal(assetId)
  strict gen = invoke(getEagleBreederAddress(),"getGenFromName",[assetInfo(assetId).value().name],[]).exactAs[String] 
  strict call = invoke(issuer, "reduceRarity", [assetId.toBase58String(), gen], [])

  [
    IntegerEntry("address_" + address + "_initTx_" + initTx + "_finishBlock", height+delayForHatching),
    StringEntry("address_" + address + "_initTx_" + initTx + "_status", "open"),
    StringEntry("address_" + address + "_initTx_" + initTx + "_assetId", assetId.toBase58String()),
    ScriptTransfer(getFeeAggregator(), sendToAggreGator, getPzlAssetId())
  ]++extra

  
}



@Callable(i)
func finishRebirth(initTx: String) = {
  finishRebirthInternal(initTx, i.caller.toString(),i.payments[0], false,"",false)
}

@Callable(i)
func finishRebirthDouble(initTx: String) = {
  #TODO CHECK IF ITEM IS ATTACHED, CHECK IT IN SC, AND THEN BURN ITEM
  if !(size(i.payments) == 2 && i.payments[0].amount==1) then throw("Invalid payment") else 
    let assetId = i.payments[0].assetId.value()
    strict boosterType = invoke(getItemsAddress(),"checkArtefactDetails",[assetId.toBase58String()],[]).exactAs[String]
    if boosterType == "ART-GIFT_DOUBL" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], true,"",false)
    else
      throw("Error! Wrong item attached to double rewards!")
}

@Callable(i)
func finishRebirthItem(initTx: String, itemCode: String) = {
  #TODO CHECK IF ITEM IS ATTACHED, CHECK IT IN SC, AND THEN BURN ITEM
  if (size(i.payments) == 2 && i.payments[0].amount==1) then
    let assetId = i.payments[0].assetId.value()
    strict boosterType = invoke(getItemsAddress(),"checkArtefactDetails",[assetId.toBase58String()],[]).exactAs[String]
    #TODO CHANGE INTO CORRECT TYPE!!!!
    if boosterType == "ART-HWERASE" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], false, itemCode,false)
    
    else if boosterType == "ART-HWRESCUE" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], false, "",true)
    else if boosterType == "ART-GIFT_DOUBL" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], true, "",false)
    else
      throw("Error! Wrong item attached ")
  else if (size(i.payments) == 1 ) then 
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[0], false,"",false)
  else throw("Invalid payments")
}

@Verifier(tx)
func verify() = {
  if isTestEnv() then 
      sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)
  else
    let firstUser = base58'6TdaXEfhnjYquvPf3yV7MFxt2CbgFmaqsvGwkKfXtKi4'
    let secondUser = base58'7DsP2WaMLocbHuUxux7pbXRjTrrZ1TFQPsi5QumS3gr8'
    let thirdUser = base58'BpFWP3p3JgYrrP45xfrKzeMcWMEXoinj4FVPPkUiA8D3'

    let firstUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], firstUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], firstUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], firstUser)) then 1
        else 0
    let secondUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], secondUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], secondUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], secondUser)) then 1
        else 0
    let thirdUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], thirdUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], thirdUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], thirdUser)) then 1
        else 0
    let signaturesCount = firstUserSigned + secondUserSigned + thirdUserSigned

    match (tx) {
        case _ => signaturesCount >= 1
    }
}
