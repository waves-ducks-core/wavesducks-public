{-# STDLIB_VERSION 7 #-}
{-# CONTENT_TYPE DAPP #-}
{-# SCRIPT_TYPE ACCOUNT #-}

func tryGetStringExternal(address: Address, key: String) = {
  address.getString(key).valueOrElse("")
}

func tryGetAddressExternal(address: Address, key: String) = {
  Address(address.getString(key).valueOrErrorMessage(key+" undefined").fromBase58String())
}

func tryGetInteger(key: String) = {
    match getInteger(this, key) {
        case b:Int => b
        case _ => 0
    }
}

func tryGetString(key: String) = {
    tryGetStringExternal(this,key)
}

func tryGetBooleanExternal(address: Address, key: String) = {
  match getBoolean(address, key) {
    case b:Boolean => b
    case _ => false
  }
}


func getBool(key: String) = {
  match getBoolean(this, key) {
      case b:Boolean => b
      case _ => false
  }
}

func isTestEnv()={
  getBool("TESTENV")
}

