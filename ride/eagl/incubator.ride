{-# STDLIB_VERSION 7 #-}
{-# CONTENT_TYPE DAPP #-}
{-# SCRIPT_TYPE ACCOUNT #-}
func getBool(key: String) = {
  match getBoolean(this, key) {
      case b:Boolean => b
      case _ => false
  }
}

func isTestEnv()={
  getBool("TESTENV")
}

func tryGetStringExternal(address: Address, key: String) = {
    match getString(address, key) {
        case a:String => a
        case _ => ""
    }
}
func tryGetString(key: String) = {
    tryGetStringExternal(this,key)
}

func staticKey_oracleAddress() = "static_oracleAddress"
func staticKey_extraFee() = "static_extraFee"
func staticKey_feeAggregator() = "static_feeAggregator"
func staticKey_refContractAddress() = "static_refContractAddress"
func staticKey_eaglRebirthAddress() = "static_eagleRebirthAddress"
func staticKey_eaglFarmingAddress() = "static_eagleStakingAddress"
func staticKey_itemsAddress() = "static_itemsAddress"
func staticKey_puzzleAssetId() = "static_puzzleAssetId"
func staticKey_rebirthAddress() = "static_rebirthAddress"

func getOracle() = Address(tryGetString(staticKey_oracleAddress()).fromBase58String())
func getFeeAggregator() = Address(tryGetStringExternal(getOracle(),staticKey_feeAggregator()).fromBase58String())
func getMintAssetId() = tryGetStringExternal(getOracle(),staticKey_puzzleAssetId()).fromBase58String() 
func getBurnAddress() = Address(tryGetStringExternal(getOracle(),"static_burnAddress").fromBase58String())
func getRefContractAddress() =  Address(tryGetStringExternal(getOracle(),staticKey_refContractAddress()).fromBase58String()) #base58'3P8ejTkfRpz9WqCwCuihesNXU5k3zmFFfVe'
func getEaglRebirthAddress() =  Address(tryGetStringExternal(getOracle(),staticKey_eaglRebirthAddress()).fromBase58String()) #base58'3PCC6fVHNa6289DTDmcUo3RuLaFmteZZsmQ'
func getDuckRebirthAddress() =  Address(tryGetStringExternal(getOracle(),staticKey_rebirthAddress()).fromBase58String()) #base58'3PCC6fVHNa6289DTDmcUo3RuLaFmteZZsmQ'
func getEaglFarmingAddress() =  Address(tryGetStringExternal(getOracle(),staticKey_eaglFarmingAddress()).fromBase58String()) #base58'3PCC6fVHNa6289DTDmcUo3RuLaFmteZZsmQ'
func getItemsAddress() =  Address(tryGetStringExternal(getOracle(),staticKey_itemsAddress()).fromBase58String())
func getCouponsAddress() = Address(tryGetStringExternal(getOracle(),"static_couponsAddress").fromBase58String())

func checkAdditionalPayment(payment: AttachedPayment)= {
  if isDefined(payment.assetId) then throw("BDCAP: Please attach waves") else
  let feeAmount = getIntegerValue(getOracle(),staticKey_extraFee())
  if payment.amount != feeAmount then throw("BDCAP: Please attach exactly "+feeAmount.toString()+" amount of wavelets") else
  [ScriptTransfer(getFeeAggregator(), feeAmount, unit)]

}

#TODO: make it configurable through oracle
let delayForHatching = 2

let HatchingStarted = "HATCHING_STARTED"
let HatchingFinished = "HATCHING_FINISHED"

func isLocked() = {
  let masterAddress = Address(base58'3PEPftf2kWZDmAaWBjs6BUJa9957kiA2PkU')
  match getInteger(masterAddress, "egglock") {
        case b:Int => b
        case _ => 0
    }
}

func getHatchingStatusKey(address: String, txId: ByteVector) = {
  # stores the fact of hatching, 
  # if key exists = hatching started 
  # if false = not claimed
  # if true = claimed and nft id will be in the key of getEAGLIdKey
  address + "_" + txId.toBase58String() +  "_status"
}

func getHatchingFinishHeightKey(address: String, txId: ByteVector) = {
  address + "_" + txId.toBase58String() +  "_fh"
}

func getEAGLIdKey(address: String, txId: ByteVector) = {
  address + "_" + txId.toBase58String() +  "_di"
}

func getHatchingIsNormalKey(address: String, txId: ByteVector) = {
  address + "_" + txId.toBase58String() + "_isNormal"
}

func getAssetIsNormalKey(assetId: String) = {
  "asset_" + assetId + "_isNormal"
}

func getEAGLStatsKey(genString: String) = {
  "stats_" + genString + "_amount"
}

func tryGetInteger(key: String) = {
    let val = match getInteger(this, key) {
        case b:Int => b
        case _ => 0
    }
    val
}

func tryGetBoolean(key: String) = {
    match getBoolean(this, key) {
        case b:Boolean => b
        case _ => false
    }
}

##
#[
#  {
#    "key": "discountCoefficient",
#    "type": "integer",
#    "value": 10
#  }
#]
let discountCoefficient = tryGetInteger("discountCoefficient")	

func getRandomNumber(variants: Int, txId: ByteVector, hatchingFinishHeight: Int, offset: Int) = {
  let randomSeedBlock = blockInfoByHeight(hatchingFinishHeight-1).value()
  let randomHash = sha256(txId + randomSeedBlock.vrf.value())
  randomHash.toInt(offset*8) % variants
}

func select(color: String)={
    let oldGenes = []
    let newGenes = [("EAGL-AAAAAAAA-G" + color, "8A-G"),("EAGL-BBBBBBBB-G" + color, "8B-G"),
                    ("EAGL-CCCCCCCC-G" + color, "8C-G"),("EAGL-DDDDDDDD-G" + color, "8D-G")]
    (oldGenes++newGenes, newGenes)
}

func wasUniqueBorn(gen: String) = {
  tryGetInteger(getEAGLStatsKey(gen))
}

func getRandomName(txId: ByteVector, hatchingFinishHeight: Int, all: Boolean) = {
  let jackpotRandom = getRandomNumber(40, txId, hatchingFinishHeight, 1)
  let entry = IntegerEntry("last_jackpot_random", jackpotRandom)
  #if (jackpotRandom == 1 && wasUniqueBorn("EAGL-WWESANTA-JU") < 4) then ("EAGL-WWESANTA-JU", "2A1E1N1S1T2W-J")
  #else 
    let colorRandom = getRandomNumber(4,  txId, hatchingFinishHeight, 1)
    let color = getElement(["A","B","C","D"],colorRandom)

    let colorSelect = select(color)

    let toPickFrom = if all then colorSelect._1 else colorSelect._2
    let typeRandom = getRandomNumber(size(toPickFrom), txId, hatchingFinishHeight, 0)
    
    getElement(toPickFrom,typeRandom)   
    
}

let typesAmount = size(select("R")._2)-1


func countEggsNeededAmount(totalEAGLsAmount: Int) = {
  let n = totalEAGLsAmount
  let g = discountCoefficient
  let t = typesAmount
  let price = pow((100 + (n*g)/(10*t)), 2, 5, 1, 2, DOWN)+600
  price * 1500000
}

func asBoolean(value: Any) = match value {
  case boolean: Boolean => boolean
  case _ => throw("TI: wrong type, expected: Boolean")
}

@Callable(i)
func reduceRarity(assetId: String, fGen: String) = {
  let asset = assetId.fromBase58String()
  if (i.caller != getEaglRebirthAddress() && i.caller != getCouponsAddress() && i.caller != this) then {
    throw("IRR: admin, coupons or rebirth only")
  } else {
    let duckGen = assetInfo(asset).value().name
    let letter = duckGen.take(6).takeRight(1)
    let farmGen = "8"+letter+"-G"
    [
      IntegerEntry(getEAGLStatsKey(duckGen), tryGetInteger(getEAGLStatsKey(duckGen)) - 1),
      IntegerEntry("stats_"+farmGen+"_quantity", tryGetInteger("stats_"+farmGen+"_quantity") - 1)
    ]
  }
}

@Callable(i)
func increaseRarity(assetId: String, fGen: String) = {
  let asset = assetId.fromBase58String()
  if (i.caller != getEaglRebirthAddress() && i.caller != this) then {
    throw("IRR: admin or rebirth only")
  } else {
    let duckGen = assetInfo(asset).value().name
    let letter = duckGen.take(6).takeRight(1)
    let farmGen = "8"+letter+"-G"
    [
      IntegerEntry(getEAGLStatsKey(duckGen), tryGetInteger(getEAGLStatsKey(duckGen)) + 1),
      IntegerEntry("stats_"+farmGen+"_quantity", tryGetInteger("stats_"+farmGen+"_quantity") + 1)
    ]
  }
}

@Callable(i)
func configureOracle(oracle: String) = {
  if i.caller != this then throw("ICU: admin only") else 
  [
    StringEntry("static_oracleAddress",oracle)
  ]

}

@Callable(i)
func issueJackpot(address: String, txIdStr: String, gen: String) = {
  if (i.caller != getEaglRebirthAddress() && i.caller != this) then {
    throw("ISJ: admin or rebirth only")
  } else {
    let txId = fromBase58String(txIdStr)
    let hatchingStatusKey = getHatchingStatusKey(address, txId)
    let finishHeightKey = getHatchingFinishHeightKey(address, txId)

    let totalDucksAmount = tryGetInteger("eagl_amount")
    let eggsNeeded = countEggsNeededAmount(totalDucksAmount)

    let (duckGen, farmGen) = ("EAGL-"+gen+"-JU", "8W-J")
    let description = "{\"genotype\": \"" + duckGen + "\", \"crossbreeding\": true}"

    let asset = Issue(duckGen, description, 1, 0, false, unit, height)
    let assetId = asset.calculateAssetId()

    let duckIdKey = getEAGLIdKey(address, txId)
    let valueDuckIdKeyExits = tryGetString(duckIdKey)
    if valueDuckIdKeyExits != "" then throw("ISJ: You will override following duckId :"+duckIdKey+" make sure that your txId is unique!") else
    ([
      IntegerEntry(getHatchingFinishHeightKey(address, txId), height),
      IntegerEntry("eagl_amount", totalDucksAmount + 1),
      IntegerEntry("eagl_last_price", eggsNeeded / 1500000),
    
      StringEntry(hatchingStatusKey, HatchingFinished),
      StringEntry(duckIdKey, assetId.toBase58String()),
      StringEntry(assetId.toBase58String(), duckIdKey),
      IntegerEntry(getEAGLStatsKey(duckGen), tryGetInteger(getEAGLStatsKey(duckGen)) + 1),
      IntegerEntry("stats_"+farmGen+"_quantity", tryGetInteger("stats_"+farmGen+"_quantity") + 1),
      asset,
      ScriptTransfer(addressFromString(address).value(), 1, assetId)
    ], assetId.toBase58String())
  }
}

@Callable(i)
func issueFree(address: String, txIdStr: String, isNormal: Boolean) = {
  if (i.caller != getEaglRebirthAddress() && i.caller != getDuckRebirthAddress()) then {
    throw("EIF: rebirth only")
  } else {
    let txId = fromBase58String(txIdStr)
    let hatchingStatusKey = getHatchingStatusKey(address, txId)
    let finishHeightKey = getHatchingFinishHeightKey(address, txId)

    let totalDucksAmount = tryGetInteger("eagl_amount")
    let eggsNeeded = countEggsNeededAmount(totalDucksAmount)

    let (EAGLGen, farmGen) = getRandomName(txId, valueOrErrorMessage(transactionHeightById(txId),txIdStr+ " not found "+toBase58String(txId)) + 1, true)
    let description = "{\"genotype\": \"" + EAGLGen + "\", \"crossbreeding\": true}"

    let asset = Issue(EAGLGen, description, 1, 0, false, unit, height)
    let assetId = asset.calculateAssetId()

    let amount = tryGetInteger(getEAGLStatsKey(EAGLGen)) + 1
    let normalEntries = if isNormal then [BooleanEntry(getAssetIsNormalKey(assetId.toBase58String()), true)] else []

    let duckIdKey = getEAGLIdKey(address, txId)
    ([
      IntegerEntry(getHatchingFinishHeightKey(address, txId), height),
      IntegerEntry("eagl_amount", totalDucksAmount + 1),
      IntegerEntry("eagl_last_price", eggsNeeded / 1500000),
      StringEntry(hatchingStatusKey, HatchingFinished),
      BooleanEntry(getHatchingIsNormalKey(address, txId), isNormal),
      StringEntry(duckIdKey, assetId.toBase58String()),
      StringEntry(assetId.toBase58String(), duckIdKey),
      IntegerEntry(getEAGLStatsKey(EAGLGen), amount),
      IntegerEntry("stats_"+farmGen+"_quantity", tryGetInteger("stats_"+farmGen+"_quantity") + 1)
    ] ++ normalEntries ++ [
      asset,
      ScriptTransfer(addressFromString(address).value(), 1, assetId)
    ], assetId.toBase58String())
  }
}

@Callable(i)	
func setDiscount(val: Int) = {	
  if (i.caller != this) then {	
    throw("admin_only")	
  } else {	
    [IntegerEntry("discountCoefficient", val)]	
  }	
}

@Callable(i)
func startHatching(refererAddress: String, isNormal: Boolean) = {
  strict feeValidate = checkAdditionalPayment(i.payments[0])
  #TODO: add validation that feeValidate payment is added!
  if (isLocked() > 0) then {
    throw("EGG operations are temporarily locked")
  } else {
    let totalCaniAmount = tryGetInteger("eagl_amount")
    let giantEggsNeeded = countEggsNeededAmount(totalCaniAmount)
    let eggsNeeded = if isNormal then giantEggsNeeded / 10 else giantEggsNeeded


    let results = [
        StringEntry(getHatchingStatusKey(i.originCaller.toString(), i.transactionId), HatchingStarted),
        IntegerEntry(getHatchingFinishHeightKey(i.originCaller.toString(), i.transactionId), height + delayForHatching),
        BooleanEntry(getHatchingIsNormalKey(i.originCaller.toString(), i.transactionId), isNormal),
        IntegerEntry("eagl_amount", totalCaniAmount + 1),
        IntegerEntry("eagl_last_price", giantEggsNeeded / 1500000)
      ]

    let firstPayment = i.payments[1].value()
    let leftToPay = 
    if size(i.payments) == 3 then {
          strict boosterType = invoke(getItemsAddress(),"checkArtefactDetails",[i.payments[2].value().assetId.value().toBase58String()],[]).exactAs[String]
          if (boosterType == "ART-EAGLCPN") then eggsNeeded * 80 / 100 else eggsNeeded

          }else 
            eggsNeeded
    if (firstPayment.assetId != getMintAssetId()) then throw("TB: You can attach only Puzzle") else 
    if (firstPayment.amount < leftToPay) then throw("TB: To breed a Eagle you following amount of Puzzle: " + leftToPay.toString()+ " "+i.caller.toString()) else
    strict addMore = invoke(getEaglFarmingAddress(), "addPuzzleAndStakeMore", [], [AttachedPayment(getMintAssetId(), leftToPay)])

    let refund = if i.payments[1].amount - leftToPay > 0 then [ScriptTransfer(i.caller, i.payments[1].amount - leftToPay, getMintAssetId())] else []
   
    results ++ refund++feeValidate

  }
}


@Callable(i)
func finishHatching(txIdStr: String) = {
  strict feeValidate = checkAdditionalPayment(i.payments[0])
  #TODO: add validation that feeValidate payment is added!
  let txId = fromBase58String(txIdStr)
  let hatchingStatusKey = getHatchingStatusKey(i.caller.toString(), txId)
  let finishHeightKey = getHatchingFinishHeightKey(i.caller.toString(), txId)
  let EAGLIdKey = getEAGLIdKey(i.caller.toString(), txId)
  let isNormalKey = getHatchingIsNormalKey(i.caller.toString(), txId)

  let hatchingTxStatus = getStringValue(this, hatchingStatusKey)
  let hatchingFinishHeight = getIntegerValue(this, finishHeightKey)
  let isNormal = tryGetBoolean(isNormalKey)
  
  if (hatchingTxStatus == HatchingFinished) then {
    let EAGLId = getStringValue(this, getEAGLIdKey(i.caller.toString(), txId))
    throw("The Eagle was hatched and claimed already, here is the folowing: " + EAGLId)
  } else 
    if (hatchingFinishHeight > height) then throw("Hatching is not finished yet " + (hatchingFinishHeight - height).toString() + " blocks remaining, it will take around " +  (hatchingFinishHeight - height).toString() + " minutes")
    else {
      let (EAGLGen, farmGen) = getRandomName(txId, hatchingFinishHeight, false)
      let description = "{\"genotype\": \"" + EAGLGen + "\", \"crossbreeding\": true}"

      let asset = Issue(EAGLGen, description, 1, 0, false, unit, hatchingFinishHeight)
      let assetId = asset.calculateAssetId()
      let normalEntries = if isNormal then [BooleanEntry(getAssetIsNormalKey(assetId.toBase58String()), true)] else []

      let amount = tryGetInteger(getEAGLStatsKey(EAGLGen)) + 1

      [
        StringEntry(hatchingStatusKey, HatchingFinished),
        StringEntry(EAGLIdKey, assetId.toBase58String()),
        StringEntry(assetId.toBase58String(), EAGLIdKey),
        IntegerEntry(getEAGLStatsKey(EAGLGen), amount),
        IntegerEntry("stats_"+farmGen+"_quantity", tryGetInteger("stats_"+farmGen+"_quantity") + 1)
      ] ++ normalEntries ++ [
        asset,
        ScriptTransfer(i.caller, 1, assetId)
      ]++feeValidate
    }
}


@Verifier(tx)
func verify() = {
  if isTestEnv() then 
      sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)
  else
    let firstUser = base58'6TdaXEfhnjYquvPf3yV7MFxt2CbgFmaqsvGwkKfXtKi4'
    let secondUser = base58'7DsP2WaMLocbHuUxux7pbXRjTrrZ1TFQPsi5QumS3gr8'
    let thirdUser = base58'BpFWP3p3JgYrrP45xfrKzeMcWMEXoinj4FVPPkUiA8D3'

    let firstUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], firstUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], firstUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], firstUser)) then 1
        else 0
    let secondUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], secondUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], secondUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], secondUser)) then 1
        else 0
    let thirdUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], thirdUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], thirdUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], thirdUser)) then 1
        else 0
    let signaturesCount = firstUserSigned + secondUserSigned + thirdUserSigned

    match (tx) {
        case _ => signaturesCount >= 1
    }
}

        