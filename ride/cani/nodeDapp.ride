{-# STDLIB_VERSION 5 #-}
{-# CONTENT_TYPE DAPP #-}
{-# SCRIPT_TYPE ACCOUNT #-}
func tryGetStringExternal(address: Address, key: String) = {
    match getString(address, key) {
        case a:String => a
        case _ => ""
    }
}
func tryGetString(key: String) = {
    tryGetStringExternal(this,key)
}
func staticKey_oracleAddress() = "static_oracleAddress"
func getOracle() = Address(tryGetString(staticKey_oracleAddress()).fromBase58String())
func staticKey_canineStakingAddress()= "static_canineStakingAddress"
func getFeeAggregatorAddress() =  Address(tryGetStringExternal(getOracle(),"static_feeAggregator").fromBase58String())
func getCanineStakingAddress() =  Address(tryGetStringExternal(getOracle(),staticKey_canineStakingAddress()).fromBase58String())
func getEggPoolAddress() = Address(tryGetStringExternal(getOracle(),"static_eggPool").fromBase58String())
func getBurnAddress() = Address(tryGetStringExternal(getOracle(),"static_burnAddress").fromBase58String())
func getEggAssetId() = tryGetStringExternal(getOracle(),"static_eggAssetId").fromBase58String()

func tryGetIntegerExternal(address: Address, key: String) = {
    match getInteger(address, key) {
        case a:Int => a
        case _ => 0
    }
}

func getPoolLeasesAmount() = {
  let poolWavesDucks = addressFromStringValue("3PAZsTidSJHjo1xxqY9t3Rvuk144u3EHQXQ")
  let poolCf = addressFromStringValue("3P2A54fWwUktfGVDpNdGaDPdgGbfA3LR1aV")
  let poolPete = addressFromStringValue("3P3zkxHhAzRzV9PBLB14JXG4ZEEPv4LtDyQ")
  let poolArkimals = addressFromStringValue("3PGJ8DVtsPk3uJtMMuDAHEsCbWMnnL3pKWB")
  let poolTnWaves = addressFromStringValue("3PFZCA9X3yWhuY4E96p21T6uQNbX41AwifR")
  let poolEggW = addressFromStringValue("3PMmRaba5X3gXQ4ya9tsJFwpty49g2tvq2S")

  tryGetIntegerExternal(poolWavesDucks, "leasing_amount") +
  tryGetIntegerExternal(poolCf, "leasing_amount") +
  tryGetIntegerExternal(poolPete, "leasing_amount") +
  tryGetIntegerExternal(poolArkimals, "global_lastLeaseAmount") +
  tryGetIntegerExternal(poolTnWaves, "global_lastLeaseAmount") +
  tryGetIntegerExternal(poolEggW, "global_lastLeaseAmount")
}

func routeWavesRewards(balance: Int) = {
  if balance <= 0 then [] else {
    let generating = wavesBalance(this).generating
    let poolLeases = getPoolLeasesAmount()
    let rawPoolReward = if generating <= 0 then 0 else fraction(balance, poolLeases, generating)
    let poolReward = if rawPoolReward > balance then balance else rawPoolReward

    let nonPoolReward = balance - poolReward
    let poolFee = poolReward / 2
    let poolBuyback = poolReward - poolFee
    let nonPoolTopup = nonPoolReward / 10 * 9
    let totalFee = poolFee + nonPoolReward - nonPoolTopup

    strict topUp = if nonPoolTopup > 0 then {
      invoke(getCanineStakingAddress(), "topUpReward", [], [AttachedPayment(unit, nonPoolTopup)])
    } else { unit }

    strict buybackAndBurn = if poolBuyback > 0 then {
      let eggAssetId = getEggAssetId()
      strict swapToEgg = invoke(getEggPoolAddress(), "swap", [eggAssetId.toBase58String(), 0], [AttachedPayment(unit, poolBuyback)])
      let eggAmount = assetBalance(this, eggAssetId)
      if eggAmount > 0 then {
        invoke(getBurnAddress(), "burnAttachedPayments", [], [AttachedPayment(eggAssetId, eggAmount)])
      } else { unit }
    } else { unit }

    if totalFee > 0 then [ScriptTransfer(getFeeAggregatorAddress(), totalFee, unit)] else []
  }
}

@Callable(i)
func configureOracle(oracle: String) = {
  if i.caller != this then throw("ICU: admin only") else 
  [
    StringEntry("static_oracleAddress",oracle)
  ]

}

@Callable(i)
func transferRewardsToCanineStaking() = {
  #if i.caller != this then throw("ICU: admin only") else 
  let balance = wavesBalance(this).available-10_0000_0000
  (routeWavesRewards(balance), balance)
}


@Callable(i)
func claimAndLiquidateLPAndUnits() = {
  let processBlocksDapp = addressFromStringValue("3PJVm7xLPabmYohbnvdgGDYHMwnZxF2x18m")
  let wxPool = addressFromStringValue("3P68zNiufsu1viZpu1aY3cdahRRKcvV5N93")
  let wavesdLP = "HYogWffUjS8Uw4bYA1Dn3qrGmJerMqkf139aJcHhk8yq".fromBase58String()
  let units = "GjwAHMjqWzYR4LgoNy91CxUKAGJN79h2hseZoae4nU8t".fromBase58String()

  #strict processBlocks = invoke( processBlocksDapp, "processBlocks", [],[])
  strict claimLP = invoke(processBlocksDapp, "claimLP", [],[])

  strict liquidateLP = invoke(wxPool, "swap", [0,"WAVES",this.toString()],[AttachedPayment(wavesdLP,assetBalance(this,wavesdLP))])
  strict liquidateUnits = invoke(wxPool, "swap", [0,"WAVES",this.toString()],[AttachedPayment(units,assetBalance(this,units))])

  let balance = wavesBalance(this).available-10_0000_0000
  (routeWavesRewards(balance), balance)
}

@Verifier(tx)
func verify () = match tx {

    case ss: SetScriptTransaction => 
              let Admin = base58'BpFWP3p3JgYrrP45xfrKzeMcWMEXoinj4FVPPkUiA8D3'
              sigVerify(tx.bodyBytes, tx.proofs[0], Admin)
    case _ => 

        sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)

}
