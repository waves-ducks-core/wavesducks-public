# Farm NFT tiers are 1-based and follow the canonical breeding order.
func getFarmNftTier(generation:String) = {
    if generation == "G" then 1
    else if generation == "H" then 2
    else if generation == "I" then 3
    else if generation == "K" then 4
    else if generation == "L" then 5
    else if generation == "M" then 6
    else if generation == "N" then 7
    else if generation == "O" then 8
    else throw("CDNIG: unsupported NFT generation")
}

func getFarmNftClass(issuer:Address) = {
    if issuer == getIncubatorAddress() || issuer == getBreedingAddress() then "DUCK"
    else if issuer == getCanineIncubatorAddress() || issuer == getCanineBreederAddress() then "CANINE"
    else if issuer == getFelineIncubatorAddress() || issuer == getFelineBreederAddress() then "FELINE"
    else if issuer == getTurtleIncubatorAddress() || issuer == getTurtleBreederAddress() then "TURTLE"
    else if issuer == getEagleIncubatorAddress() || issuer == getEagleBreederAddress() then "EAGLE"
    else if issuer == getBullIncubatorAddress() || issuer == getBullBreederAddress() then "BULL"
    else throw("CDNIG: unsupported NFT issuer")
}

func isFarmNftBreeder(issuer:Address) = {
    issuer == getBreedingAddress() ||
    issuer == getCanineBreederAddress() ||
    issuer == getFelineBreederAddress() ||
    issuer == getTurtleBreederAddress() ||
    issuer == getEagleBreederAddress() ||
    issuer == getBullBreederAddress()
}

# Domain separation prevents signatures for other backend-authorized methods
# (for example feedDuckling) from being replayed as SPICE withdrawals.
func getGameSpiceWithdrawProof(amount:Int, nonce:Int, expiresAt:Int, user:String) = {
    makeString(["withdrawSpiceFromGame",this.toString(),amount.toString(),nonce.toString(),expiresAt.toString(),user], ";")
}

func getSummerLifetimeBurned(user:String) = tryGetIntegerExternal(getBurnAddress(), burnUserGlobalKey(user))
func hasSummerBurnEligibility(user:String) = getSummerLifetimeBurned(user) >= 5_0000_0000
func summerTargetAmount() = 1000
func isSummerComplete() = tryGetInteger(summerGlobalContributedKey()) >= summerTargetAmount()
func isSummerEligible(user:String) = {
    hasSummerBurnEligibility(user) && tryGetInteger(summerUserContributedKey(user)) >= 5
}

func summerRankEntries(rank:Int, user:String, score:Int, order:Int) = [
    StringEntry(summerRankUserKey(rank), user),
    IntegerEntry(summerRankScoreKey(rank), score),
    IntegerEntry(summerRankOrderKey(rank), order)
]

func isBetterSummerRank(score:Int, order:Int, rankedUser:String, rankedScore:Int, rankedOrder:Int) = {
    rankedUser == "" || score > rankedScore || (score == rankedScore && order < rankedOrder)
}

func updateSummerLeaderboard(user:String, score:Int, order:Int) = {
    let r1uRaw = tryGetString(summerRankUserKey(1))
    let r1sRaw = tryGetInteger(summerRankScoreKey(1))
    let r1oRaw = tryGetInteger(summerRankOrderKey(1))
    let r2uRaw = tryGetString(summerRankUserKey(2))
    let r2sRaw = tryGetInteger(summerRankScoreKey(2))
    let r2oRaw = tryGetInteger(summerRankOrderKey(2))
    let r3uRaw = tryGetString(summerRankUserKey(3))
    let r3sRaw = tryGetInteger(summerRankScoreKey(3))
    let r3oRaw = tryGetInteger(summerRankOrderKey(3))
    let r4uRaw = tryGetString(summerRankUserKey(4))
    let r4sRaw = tryGetInteger(summerRankScoreKey(4))
    let r4oRaw = tryGetInteger(summerRankOrderKey(4))
    let r5uRaw = tryGetString(summerRankUserKey(5))
    let r5sRaw = tryGetInteger(summerRankScoreKey(5))
    let r5oRaw = tryGetInteger(summerRankOrderKey(5))

    let r1u = if r1uRaw == user then r2uRaw else r1uRaw
    let r1s = if r1uRaw == user then r2sRaw else r1sRaw
    let r1o = if r1uRaw == user then r2oRaw else r1oRaw

    let r2u = if r1uRaw == user then r3uRaw else if r2uRaw == user then r3uRaw else r2uRaw
    let r2s = if r1uRaw == user then r3sRaw else if r2uRaw == user then r3sRaw else r2sRaw
    let r2o = if r1uRaw == user then r3oRaw else if r2uRaw == user then r3oRaw else r2oRaw

    let r3u = if r1uRaw == user then r4uRaw else if r2uRaw == user then r4uRaw else if r3uRaw == user then r4uRaw else r3uRaw
    let r3s = if r1uRaw == user then r4sRaw else if r2uRaw == user then r4sRaw else if r3uRaw == user then r4sRaw else r3sRaw
    let r3o = if r1uRaw == user then r4oRaw else if r2uRaw == user then r4oRaw else if r3uRaw == user then r4oRaw else r3oRaw

    let r4u = if r1uRaw == user then r5uRaw else if r2uRaw == user then r5uRaw else if r3uRaw == user then r5uRaw else if r4uRaw == user then r5uRaw else r4uRaw
    let r4s = if r1uRaw == user then r5sRaw else if r2uRaw == user then r5sRaw else if r3uRaw == user then r5sRaw else if r4uRaw == user then r5sRaw else r4sRaw
    let r4o = if r1uRaw == user then r5oRaw else if r2uRaw == user then r5oRaw else if r3uRaw == user then r5oRaw else if r4uRaw == user then r5oRaw else r4oRaw

    let userAlreadyRanked = r1uRaw == user || r2uRaw == user || r3uRaw == user || r4uRaw == user || r5uRaw == user
    let r5u = if userAlreadyRanked then "" else r5uRaw
    let r5s = if userAlreadyRanked then 0 else r5sRaw
    let r5o = if userAlreadyRanked then 0 else r5oRaw

    if isBetterSummerRank(score, order, r1u, r1s, r1o) then
        summerRankEntries(1,user,score,order)++
        summerRankEntries(2,r1u,r1s,r1o)++
        summerRankEntries(3,r2u,r2s,r2o)++
        summerRankEntries(4,r3u,r3s,r3o)++
        summerRankEntries(5,r4u,r4s,r4o)
    else if isBetterSummerRank(score, order, r2u, r2s, r2o) then
        summerRankEntries(1,r1u,r1s,r1o)++
        summerRankEntries(2,user,score,order)++
        summerRankEntries(3,r2u,r2s,r2o)++
        summerRankEntries(4,r3u,r3s,r3o)++
        summerRankEntries(5,r4u,r4s,r4o)
    else if isBetterSummerRank(score, order, r3u, r3s, r3o) then
        summerRankEntries(1,r1u,r1s,r1o)++
        summerRankEntries(2,r2u,r2s,r2o)++
        summerRankEntries(3,user,score,order)++
        summerRankEntries(4,r3u,r3s,r3o)++
        summerRankEntries(5,r4u,r4s,r4o)
    else if isBetterSummerRank(score, order, r4u, r4s, r4o) then
        summerRankEntries(1,r1u,r1s,r1o)++
        summerRankEntries(2,r2u,r2s,r2o)++
        summerRankEntries(3,r3u,r3s,r3o)++
        summerRankEntries(4,user,score,order)++
        summerRankEntries(5,r4u,r4s,r4o)
    else if isBetterSummerRank(score, order, r5u, r5s, r5o) then
        summerRankEntries(1,r1u,r1s,r1o)++
        summerRankEntries(2,r2u,r2s,r2o)++
        summerRankEntries(3,r3u,r3s,r3o)++
        summerRankEntries(4,r4u,r4s,r4o)++
        summerRankEntries(5,user,score,order)
    else
        summerRankEntries(1,r1u,r1s,r1o)++
        summerRankEntries(2,r2u,r2s,r2o)++
        summerRankEntries(3,r3u,r3s,r3o)++
        summerRankEntries(4,r4u,r4s,r4o)++
        summerRankEntries(5,r5u,r5s,r5o)
}

func isSummerTop5(user:String) = {
    tryGetString(summerRankUserKey(1)) == user ||
    tryGetString(summerRankUserKey(2)) == user ||
    tryGetString(summerRankUserKey(3)) == user ||
    tryGetString(summerRankUserKey(4)) == user ||
    tryGetString(summerRankUserKey(5)) == user
}

func addCouponsInternal(user:String,amount:Int)={
    let keyOld = couponsUserActiveOld(user)
    let key = couponsUserActive(user)
    let couponsOld = tryGetInteger(key)
    let coupons = couponsOld+amount
    [
        IntegerEntry(keyOld,couponsOld),
        IntegerEntry(key,coupons)
    ]
}

#First day ever! Saturday, September 23, 2023 0:00:00
let startTsMs = 1695427200000
func calculateDaysSinceStart()={
  let diff = lastBlock.timestamp-startTsMs
  let daysPassed = diff/ (86400 *1000)
  daysPassed
}

func hasDoneTask7Days(day: Int,address: String, actionName:String, rewardAmount:Int, rewardAmountWeekly:Int, asset: String)={
    let userExperienceKey = userExperience(address)
    let userExpTilldate = tryGetInteger(userExperienceKey)

    let checkDayKey = actionPerAddressPerUserLastCheckDay(address,actionName)
    let daysInRowKey = actionPerAddressPerUserAmountInARow(address,actionName)
    let lastCheckDay = tryGetInteger(checkDayKey)
    let daysInRow = tryGetInteger(daysInRowKey)
    let daysInRowUpdate = if lastCheckDay==day-1 then daysInRow+1 else if lastCheckDay<day-1 then 1 else 0
    let lastCheckDayUpdate = day
    let counterOutput = tryGetInteger(counter())
    let vegg = if asset == "VEGG" then true else false
    let reward = if daysInRowUpdate == 7 || daysInRowUpdate == 14 || daysInRowUpdate == 21 || daysInRowUpdate == 28 then 
        let payment = if vegg then addCouponsInternal(address,rewardAmount) else [ScriptTransfer(addressFromStringValue(address),rewardAmountWeekly,asset.fromBase58String())]
        payment++
        [
            StringEntry("DEBUG_WEEKLY",daysInRowUpdate.toString()),
            StringEntry(rewardKey(address,"WEEKLY",actionName,asset,(counterOutput+2).toString()),rewardAmountWeekly.toString()),
            IntegerEntry(daysInRowKey,daysInRowUpdate),
            IntegerEntry(counter(),counterOutput+2)
        ] else [
            IntegerEntry(daysInRowKey,daysInRowUpdate)
        ]

    let monthlyReward = if daysInRowUpdate == 31 then 
        let payment = if vegg then addCouponsInternal(address,rewardAmount) else [ScriptTransfer(addressFromStringValue(address),rewardAmountWeekly,asset.fromBase58String())]
        payment++
        [
            IntegerEntry(daysInRowKey,0),
            #ScriptTransfer(addressFromStringValue(address),rewardAmountWeekly,getSpiceAssetId()),
            StringEntry("DEBUG_MONTHLY","MOTNHLY REWARD"),
            StringEntry(rewardKey(address,"WEEKLY",actionName,asset,(counterOutput+2).toString()),rewardAmountWeekly.toString())

        ] else []
    
    let payment = if vegg then addCouponsInternal(address,rewardAmount) else [ScriptTransfer(addressFromStringValue(address),rewardAmount,asset.fromBase58String())]

    [
        IntegerEntry(checkDayKey,lastCheckDayUpdate),
        IntegerEntry(userExperienceKey,userExpTilldate+1),
        IntegerEntry(counter(),counterOutput+1),
        StringEntry(rewardKey(address,"DAILY",actionName,asset,(counterOutput+1).toString()),rewardAmount.toString())

    ]++reward++monthlyReward++payment
}

func payAction(actionName:String, userAddress: Address, amount: Int, day:Int)={
    let composedKey = if tryGetBoolean("TASK_"+actionName+"_EVERY") then actionName else actionName+"_"+amount.toString()
    let asset = if tryGetString("TASK_"+composedKey+"_ASSET") != "" then tryGetString("TASK_"+composedKey+"_ASSET") else getSpiceAssetId().toBase58String()
    if tryGetBoolean("TASK_"+composedKey) then
        hasDoneTask7Days(day,userAddress.toString(),composedKey,tryGetInteger("TASK_"+composedKey+"_REWARD_DAILY"),tryGetInteger("TASK_"+composedKey+"_REWARD_WEEKLY"),asset)
    else []
}

func recordActionInternal(actionName:String, addressCaller: Address, address:Address)= {
    if !containsElement(scCanUseCoupons, addressCaller) then throw("CRA: Only certain smart contracts can use this reward module!") else #prevents outsider to implement our rewards

        let day = calculateDaysSinceStart()
        let actionKey = actionPerAddressPerUserPerDay(address.toString(),actionName,addressCaller.toString(),day.toString())
        let totalActions = tryGetInteger(actionKey)+1
        [
            IntegerEntry(actionKey,totalActions)
        ]++payAction(actionName,address,totalActions, day)
}


@Callable(i)
func burnEggs()= {
    let burnActiveKey = "burn_eggs_active"
    let burnTotalKey = "burn_eggs_total"
    let burnActive = tryGetBoolean(burnActiveKey)
    if burnActive then
            let invoker = i.caller.toString()
            let key = burnUserKey(invoker)
            let userBurned = tryGetInteger(key)
            if i.payments.size() != 1 || i.payments[0].assetId != getEggAssetId() then throw("CBE: send eggs only to burn eggs") else
            let burnAmount = i.payments[0].amount
            let newUserBurned = userBurned+burnAmount
            let totalBurned = tryGetInteger(burnTotalKey)
            let newTotalBurned = totalBurned+burnAmount
            let amountToBurn = burnAmount/100*98
            strict burnCall = invoke(getBurnAddress(), "burnAttachedPayments", [],[AttachedPayment(getEggAssetId(),amountToBurn)])
            let totalAmount = if newUserBurned >200_0000_0000 then burnAmount*2
                            else if newUserBurned >100_0000_0000 then burnAmount*3/2
                            else if newUserBurned >50_0000_0000 then burnAmount*4/3
                            else if newUserBurned >20_0000_0000 then burnAmount*5/4
                            else burnAmount*21/20
            addCouponsInternal(invoker,totalAmount)++
            [
                IntegerEntry(key,newUserBurned),
                IntegerEntry(burnTotalKey,newTotalBurned),
                ScriptTransfer(getFeeAggregatorAddress(),i.payments[0].amount - amountToBurn,i.payments[0].assetId)

            ]
    else
        throw("CBE: burn eggs not active")
}

@Callable(i)
func depositIntoGame(purpose: String) = {
    if purpose.size() == 0 || purpose.size() > 64 then throw("CDIG: invalid purpose") else
    if i.payments.size() != 1 then throw("CDIG: attach exactly one payment") else
    let user = i.caller.toString()
    let amount = i.payments[0].amount
    if amount <= 0 then throw("CDIG: amount must be positive") else
    let assetId = i.payments[0].assetId
    if assetId != getEggAssetId() && assetId != getTnAssetId() && assetId != getSpiceAssetId() && assetId != unit then
        throw("CDIG: unsupported payment asset")
    else
    strict burnCall = if assetId == getEggAssetId() then
        invoke(getBurnAddress(), "burnAttachedPayments", [], [AttachedPayment(getEggAssetId(), amount)])
        else nil
    let routedPayment = if assetId == getEggAssetId() then [] else
        [ScriptTransfer(getFeeAggregatorAddress(), amount, assetId)]
    [
        IntegerEntry(gameDepositTotalKey(), tryGetInteger(gameDepositTotalKey()) + amount),
        IntegerEntry(gameDepositPurposeTotalKey(purpose), tryGetInteger(gameDepositPurposeTotalKey(purpose)) + amount),
        IntegerEntry(gameDepositUserTotalKey(user), tryGetInteger(gameDepositUserTotalKey(user)) + amount),
        IntegerEntry(gameDepositUserPurposeKey(user, purpose), tryGetInteger(gameDepositUserPurposeKey(user, purpose)) + amount),
        StringEntry(gameDepositLastPurposeKey(user), purpose)
    ] ++ routedPayment
}

@Callable(i)
func depositNftIntoGame() = {
    if i.caller != i.originCaller then throw("CDNIG: direct user call required") else
    if i.payments.size() != 2 || i.payments[0].assetId == unit || i.payments[0].amount != 1 then throw("CDNIG: attach one NFT and the EGG fee") else
    let assetId = i.payments[0].assetId.value()
    let feePayment = i.payments[1]
    let asset = assetInfo(assetId).value()
    let assetIdStr = assetId.toBase58String()
    let issuer = asset.issuer
    if !isNft(asset) then throw("CDNIG: attached asset is not an NFT") else
    if feePayment.assetId != getEggAssetId() || feePayment.amount != gameNftDepositFee() then throw("CDNIG: attach exactly 0.5 EGG as fee") else
    if tryGetString(gameNftDepositAssetKey(assetIdStr,"CLASS")) != "" then throw("CDNIG: NFT already deposited") else
        let user = i.caller.toString()
        let txId = i.transactionId.toBase58String()
        let generation = asset.name.takeRight(2).take(1)
        let tier = getFarmNftTier(generation)
        let nftClass = getFarmNftClass(issuer)
        let managesRarity = nftClass != "TURTLE"
        let farmGen = if managesRarity && isFarmNftBreeder(issuer) then
            invoke(issuer,"getGenFromName",[asset.name],[]).exactAs[String]
            else ""
        strict rarityCall = if managesRarity then invoke(issuer,"reduceRarity",[assetIdStr,farmGen],[]) else nil
        [
            StringEntry(gameNftDepositAssetKey(assetIdStr,"CLASS"),nftClass),
            IntegerEntry(gameNftDepositAssetKey(assetIdStr,"TIER"),tier),
            StringEntry(gameNftDepositAssetKey(assetIdStr,"OWNER"),user),
            StringEntry(gameNftDepositAssetKey(assetIdStr,"TX"),txId),
            IntegerEntry(gameNftDepositAssetKey(assetIdStr,"TIMESTAMP"),lastBlock.timestamp),
            StringEntry(gameNftDepositTxKey(txId),assetIdStr+";"+nftClass+";"+tier.toString()),
            IntegerEntry(gameNftDepositUserTotalKey(user),tryGetInteger(gameNftDepositUserTotalKey(user))+1),
            IntegerEntry("GAME_NFT_DEPOSIT_TOTAL",tryGetInteger("GAME_NFT_DEPOSIT_TOTAL")+1),
            Burn(assetId,1),
            Burn(getEggAssetId(),gameNftDepositFee())
        ]
}

@Callable(i)
func withdrawSpiceFromGame(backendSignature:String, amount:Int, userNonce:Int, expiresAt:Int) = {
    if i.caller != i.originCaller then throw("CWSFG: direct user call required") else
    if i.payments.size() != 0 then throw("CWSFG: payments are not accepted") else
    if amount <= 0 then throw("CWSFG: amount must be positive") else
        let user = i.caller.toString()
        let nonceKey = gameSpiceWithdrawNonceKey(user)
        let currentNonce = tryGetInteger(nonceKey)
        let proof = getGameSpiceWithdrawProof(amount,userNonce,expiresAt,user)
        if !sigVerify_8Kb(proof.toBytes(),backendSignature.fromBase58String(),getBackendPubKey()) then throw("CWSFG: invalid backend signature") else
        if lastBlock.timestamp > expiresAt then throw("CWSFG: backend authorization expired") else
        if userNonce != currentNonce+1 then throw("CWSFG: invalid user nonce") else
        if assetBalance(this,getSpiceAssetId()) < amount then throw("CWSFG: insufficient SPICE balance") else
            let txId = i.transactionId.toBase58String()
            [
                IntegerEntry(nonceKey,userNonce),
                IntegerEntry(gameSpiceWithdrawUserTotalKey(user),tryGetInteger(gameSpiceWithdrawUserTotalKey(user))+amount),
                IntegerEntry("GAME_SPICE_WITHDRAW_TOTAL",tryGetInteger("GAME_SPICE_WITHDRAW_TOTAL")+amount),
                StringEntry(gameSpiceWithdrawTxKey(txId),user+";"+amount.toString()+";"+userNonce.toString()+";"+expiresAt.toString()),
                ScriptTransfer(i.caller,amount,getSpiceAssetId())
            ]
}

@Callable(i)
func contributeSummerBeachBalls() = {
    let amount = size(i.payments)
    let user = i.caller.toString()
    if amount == 0 || amount > 10 then throw("CSBB: attach between 1 and 10 Beach Balls") else
    if !tryGetBoolean(summerActiveKey()) then throw("CSBB: summer event is not active") else
    if isSummerComplete() then throw("CSBB: summer event is complete") else
    if !hasSummerBurnEligibility(user) then throw("CSBB: at least 5 lifetime burned EGG required") else
        func burnBeachBall(acc: List[Burn], payment: AttachedPayment) = {
            if payment.amount != 1 || payment.assetId == unit then throw("CSBB: attach Beach Ball NFTs only") else
                let assetId = payment.assetId.value()
                strict artefact = invoke(getItemsAddress(),"checkArtefactDetails",[assetId.toBase58String()],[]).exactAs[String]
                if artefact != summerBeachBallType() then throw("CSBB: attached NFT is not a Beach Ball") else
                    acc++[Burn(assetId,1)]
        }
        let burns = FOLD<10>(i.payments, [], burnBeachBall)
        let oldGlobal = tryGetInteger(summerGlobalContributedKey())
        let newGlobal = oldGlobal + amount
        if newGlobal > summerTargetAmount() then throw("CSBB: contribution exceeds summer target") else
        let oldFirst50 = tryGetInteger(summerFirst50UsedKey())
        let first50Left = max([0, 50 - oldFirst50])
        let doubled = min([amount, first50Left])
        let weighted = amount + doubled
        let newFirst50 = oldFirst50 + doubled
        let oldUserContributed = tryGetInteger(summerUserContributedKey(user))
        let oldUserScore = tryGetInteger(summerUserScoreKey(user))
        let newUserContributed = oldUserContributed + amount
        let newUserScore = oldUserScore + weighted
        let order = tryGetInteger(summerOrderKey()) + 1
        let unlockedNow = newGlobal >= summerTargetAmount()

        burns++
        [
            IntegerEntry(summerGlobalContributedKey(), newGlobal),
            IntegerEntry(summerFirst50UsedKey(), newFirst50),
            IntegerEntry(summerUserContributedKey(user), newUserContributed),
            IntegerEntry(summerUserScoreKey(user), newUserScore),
            IntegerEntry(summerUserScoreOrderKey(user), order),
            IntegerEntry(summerOrderKey(), order),
            BooleanEntry(summerUnlockedKey(), unlockedNow)
        ]++if newUserContributed >= 5 then updateSummerLeaderboard(user, newUserScore, order) else []
}

@Callable(i)
func claimSummerBullHouse() = {
    let user = i.caller.toString()
    if !isSummerComplete() then throw("CSBH: summer event is not complete") else
    if !isSummerEligible(user) then throw("CSBH: at least 5 Beach Balls and 5 lifetime burned EGG are required") else
    if tryGetBoolean(summerUserBullHouseClaimedKey(user)) then throw("CSBH: Bull House already claimed") else
        strict prize = invoke(getItemsAddress(),"issueArtefactIndex",[summerBullHouseType(),user,0],[])
        [
            BooleanEntry(summerUserBullHouseClaimedKey(user), true),
            StringEntry("summer_"+user+"_bull_house_asset", prize.exactAs[String])
        ]
}

@Callable(i)
func claimSummerTop5MediumHouse() = {
    let user = i.caller.toString()
    if !isSummerComplete() then throw("CST5: summer event is not complete") else
    if !isSummerEligible(user) then throw("CST5: at least 5 Beach Balls and 5 lifetime burned EGG are required") else
    if !isSummerTop5(user) then throw("CST5: caller is not in the summer Top 5") else
    if tryGetBoolean(summerUserTop5ClaimedKey(user)) then throw("CST5: Top 5 prize already claimed") else
        strict prize = invoke(getItemsAddress(),"issueArtefactIndex",[summerMediumHouseType(),user,0],[])
        [
            BooleanEntry(summerUserTop5ClaimedKey(user), true),
            StringEntry("summer_"+user+"_top5_asset", prize.exactAs[String])
        ]
}

@Callable(i)
func configureOracle(oracle: String) = {
  if i.caller != this then throw("CCO: admin only") else 
  [
    StringEntry("static_oracleAddress",oracle)
  ]

}

@Callable(i)
func addCoupons(user:String,amount:Int) = {
    if i.caller != this && i.callerPublicKey != wAccPKey then throw("CAC: admin only") else 
    if amount >= 1000_0000 then 
        recordActionInternal("VEGG10000000",this,addressFromStringValue(user))++addCouponsInternal(user,amount)
    else if amount >= 50_0000 then
        recordActionInternal("VEGG500000",this,addressFromStringValue(user))++addCouponsInternal(user,amount)
    else
        addCouponsInternal(user,amount)

}

@Callable(i)
func resetCheater(user:String) = {
    if i.caller != this && i.callerPublicKey != wAccPKey then throw("CAC: admin only") else 
    let keyOld = couponsUserActiveOld(user)
    let key = couponsUserActive(user)
    let couponsOld = tryGetInteger(key)
    let coupons = -100000000
    [
        IntegerEntry(keyOld,couponsOld),
        IntegerEntry(key,coupons)
    ]

}

@Callable(i)
func addCouponsFarming(user:String,amount:Int) = {
    if i.caller != getVeggFarmingAddress() 
    && i.caller != getMutantFarmingAddress() 
    then throw("Method only for farming sc!") else
        addCouponsInternal(user,amount)

}

@Callable(i)
func addCouponsBatch(batch:String) = {
    if i.caller != this && i.callerPublicKey != wAccPKey then throw("CAC: admin only") else
    let couponsList = batch.split(";")
    func handleCoupon(acc: List[IntegerEntry], coupon: String) = {
        let splitArray = split(coupon,":")
        let user = splitArray[0]
        let amount = parseIntValue(splitArray[1])
        strict burnCall = invoke(getBurnAddress(), "burnByInvoke", [amount],[])
        if amount >= 1000_0000 then 
            acc++recordActionInternal("VEGG10000000",this,addressFromStringValue(user))++addCouponsInternal(user,amount)
        else if amount >= 50_0000 then
            acc++recordActionInternal("VEGG500000",this,addressFromStringValue(user))++addCouponsInternal(user,amount)
        else
            acc++addCouponsInternal(user,amount)

    }
    FOLD<20>(couponsList, [], handleCoupon)
    
}

@Callable(i)
func CFRefund(recipient: String,amount: Int)={
    #Get connected CF address (can be faked)
    let cfAddress = getStringValue(i.caller,"CF_ADDRESS")
    let key = "f_"+cfAddress+"_stake_address"
    #Get connected stake address with a CF address, can not be faked since it's pulled from masterkey
    let stakeAddress = getStringValue(getMasterAddress(),key)
    #Making sure that stakeaddress and invoker are the same and therefor valid
    if stakeAddress != i.caller.toString() then throw("CCR: This is something fishy going on!") else
    addCouponsInternal(recipient,amount)

}

@Callable(i)
func questOnePetNft (assetId: String)={
    let invoker = i.caller.toString()
    let type =  if assetInfo(assetId.fromBase58String()).value().issuer == getBreedingAddress() then "DUCK" else
                if assetInfo(assetId.fromBase58String()).value().issuer == getCanineBreederAddress() then "CANINE" else
                if assetInfo(assetId.fromBase58String()).value().issuer == getFelineBreederAddress() then "FELINE" else
                if assetInfo(assetId.fromBase58String()).value().issuer == getTurtleBreederAddress() then "TURTLE" else
                throw("Unsupported NFT!")
    let invokedKey = "q1_"+type+"_"+invoker+"_invoked"
    let amountNftInvokedKey = "q1_"+assetId+"_amount_invoked"
    let typesCompletedKey = "q1_"+invoker+"_completed"
    let totalPetKey = "q1_total"
    if tryGetBoolean(invokedKey) then throw("You already invoked this type!") else

    
    [
        BooleanEntry(invokedKey,true),
        IntegerEntry(amountNftInvokedKey,tryGetInteger(amountNftInvokedKey)+1),
        IntegerEntry(typesCompletedKey,tryGetInteger(typesCompletedKey)+1),
        IntegerEntry(totalPetKey,tryGetInteger(totalPetKey)+1)
    ]++addCouponsInternal(i.caller.toString(),110_0000)

}

@Callable(i)
func questTwoBuyPerches(type: String, color: String)={
    let invoker = i.caller.toString()
    #todo: check if user completed petting
    let typesCompletedKey = "q1_"+invoker+"_completed"
    if tryGetInteger(typesCompletedKey) <4 then throw("You need to complete the first quest!") else
    let method = if type =="TURTLE" then "addFreeBeach" else "addFreePerch"
    let amount = 100_0000
    strict invokeRes = invoke(this, "useCoupons",[amount],[]).exactAs[Int]
    if invokeRes != amount then throw("Not enough vEGG to complet this quest!") else
    let invokeAddress = if type =="TURTLE" then getTurtleStakingAddress() else
                        if type =="CANINE" then getCanineFarmingAddress() else
                        if type =="FELINE" then getFelineFarmingAddress() else
                        if type =="DUCK" then getFarmingAddress() else
                        throw("Unsupported type!")
    let invokeParams = if type =="TURTLE" then [invoker,color] else [invoker,color,1]
    strict invokeRes2 = invoke(invokeAddress, method, invokeParams,[])
    let invokedKey = "q2_"+type+"_"+invoker+"_invoked"
    let amountNftInvokedKey = "q2_"+type+"_amount_invoked"
    let typesQ2CompletedKey = "q2_"+invoker+"_completed"
    let totalQ2Key = "q2_total"
    if tryGetBoolean(invokedKey) then throw("You already invoked this type!") else
    [
        BooleanEntry(invokedKey,true),
        IntegerEntry(amountNftInvokedKey,tryGetInteger(amountNftInvokedKey)+1),
        IntegerEntry(typesQ2CompletedKey,tryGetInteger(typesQ2CompletedKey)+1),
        IntegerEntry(totalQ2Key,tryGetInteger(totalQ2Key)+1)
    ]++addCouponsInternal(i.caller.toString(),120_0000)
}
#https://docs.google.com/document/d/1FHMO20W3sZEcO4VIegoi3rHksClMYJrVndlxNKGn7Yw/edit?tab=t.0
@Callable(i)
func questThree()={
    let invoker = i.caller.toString()
    let typesCompletedKey = "q1_"+invoker+"_completed"
    if tryGetInteger(typesCompletedKey) <4 then throw("You need to complete the first quest!") else
    let amount = 400_0000
