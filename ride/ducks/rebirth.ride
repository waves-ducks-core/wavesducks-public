func getFeeAggregator() = Address(tryGetStringExternal(getOracle(),staticKey_feeAggregator()).fromBase58String())
let feeAmount = tryGetIntExternal(getOracle(),staticKey_duckRebirthAmount())

func checkReal(assetId: ByteVector) = {
  if (assetInfo(assetId).value().issuer == getBreederAddress() || assetInfo(assetId).value().issuer ==getIncubatorAddress()) then {
   assetInfo(assetId).value().issuer
  } else {
    throw("not valid NFT")
  }
}

func checkAdditionalPayment(payment: AttachedPayment)= {
  if isDefined(payment.assetId) then throw("RCAP: Please attach waves") else
  let amount = getIntegerValue(getOracle(),staticKey_extraFee())
  if payment.amount != amount then throw("RCAP: Please attach exactly "+amount.toString()+" amount of wavelets") else
  [ScriptTransfer(getFeeAggregator(), amount, unit)]

}



func tryGetInteger(key: String) = {
    tryGetIntExternal(this, key)
}

func asString(value: Any) = match value {
  case s: String => s
  case s: Int => throw("wrong type, expected: String, got: Int")
  case s: Unit => throw("wrong type, expected: String, got: Unit")
  case _ => throw("wrong type, expected: String")
}



func getAmountOrClear(amount: String) = {
  if (amount.contains("0")) then {""} else {amount}
}

func getAssetOrigin(generation: String) = {
  if (generation == "G") then {getIncubatorAddress()} else {getBreederAddress()}
}

func getAssetRarity(genotype: String, generation: String) = {
  let quantity = getIntegerValue(getAssetOrigin(generation), "stats_"+genotype+"_quantity")
  let power = pow(10000 / quantity, 4, 5, 1, 2, FLOOR)
  if (power > 0) then {power} else {2}
}

func getAssetFarmingPower(assetId: ByteVector) = {
  if (assetInfo(assetId).value().issuer == getBreederAddress() || assetInfo(assetId).value().issuer ==getIncubatorAddress()) then {
    let assetName = assetInfo(assetId).value().name
    let generation = assetName.takeRight(2).take(1)
    strict farmGen = invoke(getBreederAddress(),"getGenFromName",[assetName],[]).exactAs[String]
    (farmGen, getAssetRarity(farmGen, generation))
  } else {
    throw("not valid NFT")
  }
}

func getRandomNumber(options: Int, txId: ByteVector, hatchingFinishHeight: Int, offset: Int) = {
  let randomSeedBlock = blockInfoByHeight(hatchingFinishHeight-1).value()
  let randomHash = sha256(txId + randomSeedBlock.vrf.value())
  randomHash.toInt(offset*8) % options
}

func wasUniqueBorn(gen: String) = {
  func getCaniStatsKey(genString: String) = {
  "stats_" + genString + "_amount"
}
  tryGetIntegerExternal(getIncubatorAddress(),getCaniStatsKey(gen))
}

func getMedhouseIssuedAmount() = {
  tryGetIntegerExternal(getItemsAddress(),"stats_ART-MEDHOUSE_amount")
}

func getRandomWin(tx: ByteVector, finishHeight: Int, assetRarity: Int, blacklistCode: String) = {
  let n = getRandomNumber(1000, tx, finishHeight, 0)

  let phoenixOptions = if (assetRarity < 50)
    then 500 - ((250 * (assetRarity - 1)) / 49)
    else 250 - ((200 * (assetRarity - 50)) / 50)
  let phoenixRandom = getRandomNumber(phoenixOptions, tx, finishHeight, 1)
  let jackpotRandom = getRandomNumber(100, tx, finishHeight, 2)
  let summerJackpotRandom = getRandomNumber(1000, tx, finishHeight, 3)
  let baseResult = if (phoenixRandom == 1) then { "phoenix" } else 

  #let jackpotRandom = getRandomNumber(200, tx, finishHeight, 1)
  #let result = if (jackpotRandom == 1 && wasUniqueBorn("DUCK-WPBRDUCK-JU") < 4) then { "phoenix"} else 
    #Every % means 10 numbers
    
    if assetRarity < 50 then
      if (n < 30 && blacklistCode != "item!ART-FREEGENE") then {"item!ART-FREEGENE"} else
      if (n < 80 && blacklistCode != "item!ART-FIRE_ARMOUR") then { "item!ART-FIRE_ARMOUR" } else
      if (n < 110 && blacklistCode != "item!ART-FEED5") then { "item!ART-FEED5" } else    
      if (n < 140 && blacklistCode != "item!ART-FEED10") then { "item!ART-FEED10" } else    
      if (n < 170 && blacklistCode != "item!ART-FEED15") then { "item!ART-FEED15" } else    
      if (n < 200 && blacklistCode != "item!ART-FEED20") then { "item!ART-FEED20" } else    
      if (n < 220 && blacklistCode != "item!ART-FEED25") then { "item!ART-FEED25" } else    
      if (n < 240 && blacklistCode != "item!ART-FEED50") then { "item!ART-FEED50" } else   
      if (n < 250 && blacklistCode != "item!ART-FEED100") then { "item!ART-FEED100" } else
      if (n < 260 && blacklistCode != "item!ART-CROWN") then { "item!ART-CROWN" } else
      if (n < 300 && blacklistCode != "incubator") then { "incubator" } else
      if (n < 360 && blacklistCode != "item!ART-BUILTBODY") then { "item!ART-BUILTBODY" } else
      if (n < 380 && blacklistCode != "item!ART-SNAKE") then { "item!ART-SNAKE" } else
      if (n < 410 && blacklistCode != "item!ART-ROBODUCK") then { "item!ART-ROBODUCK" } else
      if (n < 490 && blacklistCode != "item!ART-KATANA") then { "item!ART-KATANA" } else
      if (n < 520 && blacklistCode != "item!ART-SCEPTER") then { "item!ART-SCEPTER" } else
      if (n < 580 && blacklistCode != "item!ART-MUTARIUM-D") then { "item!ART-MUTARIUM-D" } else
      if (n < 590 && blacklistCode != "item!ART-MUTARIUM-G") then { "item!ART-MUTARIUM-G" } else
      if (n < 740 && blacklistCode != "duckling_10") then { "duckling_10" } else 
      if (n < 830 && blacklistCode != "duckling_20") then { "duckling_20" } else
      if (n < 890 && blacklistCode != "duckling_40") then { "duckling_40" } else
      if (n < 930 && blacklistCode != "duckling_60") then { "duckling_60" } else
      if (n < 960 && blacklistCode != "item!ART-FIXGENE") then { "item!ART-FIXGENE" } else
      if (n < 970 && blacklistCode != "item!ART-MIRROR") then { "item!ART-MIRROR" } else
      if (n < 980 && blacklistCode != "incubator_eagle") then { "incubator_eagle" } else
      { "item!ART-CANCPN" }
      

    else 
      if (n <30 && blacklistCode != "item!ART-FREEGENE") then {"item!ART-FREEGENE"} else
      if (n <60 && blacklistCode != "item!ART-FIRE_ARMOUR") then { "item!ART-FIRE_ARMOUR" } else
      if (n <80 && blacklistCode != "item!ART-FEED5") then { "item!ART-FEED5" } else
      if (n <120 && blacklistCode != "item!ART-FEED10") then { "item!ART-FEED10" } else
      if (n <170 && blacklistCode != "item!ART-FEED15") then { "item!ART-FEED15" } else
      if (n <210 && blacklistCode != "item!ART-FEED20") then { "item!ART-FEED20" } else
      if (n <240 && blacklistCode != "item!ART-FEED25") then { "item!ART-FEED25" } else
      if (n <270 && blacklistCode != "item!ART-FEED50") then { "item!ART-FEED50" } else
      if (n <290 && blacklistCode != "item!ART-FEED100") then { "item!ART-FEED100" } else
      if (n <330 && blacklistCode != "incubator") then { "incubator" } else
      if (n <350 && blacklistCode != "item!ART-ROBODUCK") then { "item!ART-ROBODUCK" } else
      if (n <470 && blacklistCode != "item!ART-MUTARIUM-D") then { "item!ART-MUTARIUM-D" } else
      if (n <490 && blacklistCode != "item!ART-MUTARIUM-G") then { "item!ART-MUTARIUM-G" } else
      if (n <630 && blacklistCode != "duckling_10") then { "duckling_10" } else
      if (n <720 && blacklistCode != "duckling_20") then { "duckling_20" } else
      if (n <780 && blacklistCode != "duckling_40") then { "duckling_40" } else
      if (n <840 && blacklistCode != "duckling_60") then { "duckling_60" } else
      if (n <870 && blacklistCode != "item!ART-FIXGENE") then { "item!ART-FIXGENE" } else
      if (n <890 && blacklistCode != "item!ART-MIRROR") then { "item!ART-MIRROR" } else
      if (n <910 && blacklistCode != "incubator_eagle") then { "incubator_eagle" } else
      if (n < 960 && blacklistCode != "item!ART-CANCPN") then { "item!ART-CANCPN" } else
      if ( n < 980 && blacklistCode != "incubator_turtle") then { "incubator_turtle" } else
      { "incubator_canine" }
  let result = if (summerJackpotRandom == 1 && wasUniqueBorn("DUCK-WWSUMMER-JU") < 4) then
    "jackpot_summer_duck"
  else if (jackpotRandom == 1 && getMedhouseIssuedAmount() < 50)
    then "item!ART-MEDHOUSE"
    else baseResult
  (n,result,jackpotRandom,summerJackpotRandom)
}
func getRandomReturn(tx: ByteVector, finishHeight: Int)={
  let n = getRandomNumber(2, tx, finishHeight, 1)
  if n == 1 then true else false
}

func getOrigin(assetId: ByteVector) = {
  let assetName = assetInfo(assetId).value().name
  let generation = assetName.takeRight(2).take(1)
  if (generation == "G" || generation == "J") then {
    getIncubatorAddress()
  } else {
    getBreederAddress()
  }
}


func getBool(key: String) = {
  match getBoolean(this, key) {
      case b:Boolean => b
      case _ => false
  }
}

func isTestEnv()={
  getBool("TESTENV")
}


func finishRebirthInternal(initTx: String, address: String, additionalPayment: AttachedPayment,
 double: Boolean, blacklistCode: String, rescue: Boolean) = {
  let finishBlock = tryGetInteger("address_" + address + "_initTx_" + initTx + "_finishBlock")
  let assetRarity = tryGetInteger("address_" + address + "_initTx_" + initTx + "_assetRarity")
  let status = tryGetString("address_" + address + "_initTx_" + initTx + "_status")
  strict validPayment = checkAdditionalPayment(additionalPayment)
  strict recordAction = invoke(getCouponsAddress(),"recordAction",["REBIRTH"],[])

  if (status != "open") then {
    throw("rebirth is finished or not open")
  } else {
    if (height < finishBlock) then {
      throw("you cannot finish rebirth, yet")
    } else {
      let output = getRandomWin(initTx.fromBase58String(), finishBlock, assetRarity, blacklistCode)  
      let win = output._2
      let random = output._1
      let jackpotRandom = output._3
      let summerJackpotRandom = output._4


      let txId = initTx

      let result = if (win.indexOf("perch") != unit) then {
        let color = win.takeRight(1)
        strict result = if !double then 
				strict first = invoke(getFarmingAddress(), "addFreePerch", [address, color,1], [])
                [
					StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])
				]
            else  
				strict first = invoke(getFarmingAddress(), "addFreePerch", [address, color,2], [])
                [
					StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                    StringEntry("address_" + address + "_initTx_" + initTx + "_result1", first.exactAs[String]),
					StringEntry("address_" + address + "_initTx_" + initTx + "_win1", win)
                ]
				
        result
      } else if (win == "incubator") then {
        strict result = if !double then 
                            strict first = invoke(getIncubatorAddress(), "issueFreeDuck", [address, txId], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])
                            ]
			                  else
                            strict first = invoke(getIncubatorAddress(), "issueFreeDuck", [address, txId], [])
                            strict second = invoke(getBabyDuckAddress(), "issueFreeDuckling", [address, txId,100], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "duckling_100")
                            ]
        result
      }else if (win == "incubator_eagle") then {
        strict result = if !double then 
                            strict first = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])
                            ]
			                  else
                            strict first = invoke(getEagleIncubatorAddress(), "issueFree", [address, txId], [])
                            strict second = invoke(getIncubatorAddress(), "issueFreeDuck", [address, txId], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "duckling_100")
                            ]
        result
      }else if (win == "incubator_turtle") then {
        strict result = if !double then 
                            strict first = invoke(getTurtleIncubatorAddress(), "issueFreeTurtle", [address, txId], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])
                            ]
			                  else
                            strict first = invoke(getTurtleIncubatorAddress(), "issueFreeTurtle", [address, txId], [])
                            strict second = invoke(getIncubatorAddress(), "issueFreeDuck", [address, txId], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "duckling_100")
                            ]
        result
      }else if (win == "incubator_canine") then {
        strict result = if !double then 
                            strict first = invoke(getCanineIncubatorAddress(), "issueFree", [address, txId], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])
                            ]
			                  else
                            strict first = invoke(getCanineIncubatorAddress(), "issueFree", [address, txId], [])
                            strict second = invoke(getIncubatorAddress(), "issueFreeDuck", [address, txId], [])
                            [
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_result1", second.exactAs[String]),
                              StringEntry("address_" + address + "_initTx_" + initTx + "_win1", "duckling_100")
                            ]
        result
      #}else if (win == "phoenix") then {
      #  strict call = invoke(getIncubatorAddress(), "issueJackpot", [address, txId, "WWWWWWWP"], []) 
      #  [
			#StringEntry("address_" + address + "_initTx_" + initTx + "_result", call.exactAs[String])
		#]

      } else if (win == "jackpot_summer_duck") then {
        strict call = invoke(getIncubatorAddress(), "issueJackpot", [address, txId, "WWSUMMER"], [])
        [
          StringEntry("address_" + address + "_initTx_" + initTx + "_result", call.exactAs[String])
        ]

      } else if (win.indexOf("duckling") !=unit) then {
        let level = parseIntValue(win.split("_")[1])
        let levelFinal = if double then 2* level else level
        strict call = invoke(getBabyDuckAddress(), "issueFreeDuckling", [address, txId,levelFinal], []) 
        [
			StringEntry("address_" + address + "_initTx_" + initTx + "_result", call.exactAs[String])
		]

      } else if (win.indexOf("item") !=unit) then {
        let itemName = win.split("!")[1]
        strict result = if !double || itemName == "ART-MEDHOUSE" then 
			strict first = invoke(getItemsAddress(), "issueArtefactIndex", [itemName, address,0], [])
			[
				StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String])
			]
        else 
			strict first = invoke(getItemsAddress(), "issueArtefactIndex", [itemName, address,0], [])
            strict second = invoke(getItemsAddress(), "issueArtefactIndex", [itemName, address,1], [])
            [
				StringEntry("address_" + address + "_initTx_" + initTx + "_result", first.exactAs[String]),
                StringEntry("address_" + address + "_initTx_" + initTx + "_result", second.exactAs[String]),
				StringEntry("address_" + address + "_initTx_" + initTx + "_win1", win)
			]
        
        result
      }else{
        throw("RFB: Some error occured, please contact the admins!")
      }
      let returnToSender =  if rescue then getRandomReturn(initTx.fromBase58String(), finishBlock) else false
      let returnPayload = if returnToSender then
        let assetId = getStringValue("address_" + address + "_initTx_" + initTx + "_assetId").fromBase58String()
        let issuer = checkReal(assetId)   
        strict gen = invoke(getBreederAddress(),"getGenFromName",[assetInfo(assetId).value().name],[]).exactAs[String]  
        strict call = invoke(issuer, "increaseRarity", [assetId.toBase58String(), gen], [])
        [ScriptTransfer(address.addressFromStringValue(), 1,assetId)] 
      else []
      let bonusOutput = if (random %10 ==0) then
        strict bonus = invoke(getItemsAddress(),"issueArtefactIndex",["ART-MECHAEGG",address,0],[])
        [
          StringEntry("address_" + address + "_initTx_" + initTx + "_bonusItem", bonus.exactAs[String]),
          IntegerEntry("address_" + address + "_initTx_" + initTx + "_bonusRandom",random)
        ]
      else
        [
          IntegerEntry("address_" + address + "_initTx_" + initTx + "_bonusRandom",random)
        ]
      result ++ [
        StringEntry("address_" + address + "_initTx_" + initTx + "_win", win),
        StringEntry("address_" + address + "_initTx_" + initTx + "_status", "finish"),
        IntegerEntry("address_" + address + "_initTx_" + initTx + "_random",random),
        IntegerEntry("address_" + address + "_initTx_" + initTx + "_jackpotRandom",jackpotRandom),
        IntegerEntry("address_" + address + "_initTx_" + initTx + "_summerJackpotRandom",summerJackpotRandom)
        
      ]++validPayment++returnPayload#++bonusOutput
    }
  }
}

@Callable(i)
func configureOracle(oracle: String) = {
  if i.caller != this then throw("RCU: admin only") else 
  [
    StringEntry("static_oracleAddress",oracle)
  ]

}

@Callable(i)
func initRebirth(refererAddress: String) = {
  let pmt = i.payments[0]
  let assetId = pmt.assetId.value()
  let initTx = i.transactionId.toBase58String()
  let address = i.caller.toString()
  if (pmt.amount != 1) then throw("NFT is not attached") else


  strict amountPaidByCoupons = invoke(getCouponsAddress(),"useCoupons",[feeAmount/2],[]).exactAs[Int]
  let leftToPay = feeAmount-amountPaidByCoupons

  strict validPayment = checkAdditionalPayment(i.payments[1])
  let feePayment = i.payments[2].value()
  if (feePayment.assetId != getEggAssetId()) then throw("You need to attach EGG tokens as fee") else 

  strict payment = if leftToPay!=0 then {

    if (feePayment.amount < leftToPay)  then throw("You need to attach the following amount of EGG tokens as fee: 0." + leftToPay.toString()) else
        let refererRewardForPerch = fraction(leftToPay, 5, 100)
        strict refCall = invoke(getRefContractAddress(), "refPayment",
        [refererAddress], [AttachedPayment(getEggAssetId(), refererRewardForPerch)]).exactAs[Boolean]
        let topup = feeAmount/4
        let toBurn = if refCall then leftToPay-refererRewardForPerch-topup else leftToPay-topup
        strict bonusTopUp = invoke(getFarmingAddress(), "topUpReward", [],[AttachedPayment(getEggAssetId(),topup)])
        strict burnCall = invoke(getBurnAddress(), "burnAttachedPayments", [],[AttachedPayment(getEggAssetId(),toBurn)])
        
        leftToPay
  } else 0
   
  let (gen, rarity) = getAssetFarmingPower(assetId)

  strict call = invoke(getOrigin(assetId), "reduceRarity", [assetId.toBase58String(), gen], [])
  
  [
    IntegerEntry("address_" + address + "_initTx_" + initTx + "_finishBlock", height+delayForHatching),
    StringEntry("address_" + address + "_initTx_" + initTx + "_status", "open"),
    IntegerEntry("address_" + address + "_initTx_" + initTx + "_assetRarity", rarity),
    StringEntry("address_" + address + "_initTx_" + initTx + "_assetId", assetId.toBase58String())
  ]++validPayment

  
}


@Callable(i)
func finishRebirth(initTx: String) = {
 finishRebirthInternal(initTx, i.caller.toString(),i.payments[0], false,"",false)
}

@Callable(i)
func finishRebirthDouble(initTx: String) = {
  #TODO CHECK IF ITEM IS ATTACHED, CHECK IT IN SC, AND THEN BURN ITEM
  if !(size(i.payments) == 2 && i.payments[0].amount==1) then throw("Invalid payment") else 
    let assetId = i.payments[0].assetId.value()
    strict boosterType = invoke(getItemsAddress(),"checkArtefactDetails",[assetId.toBase58String()],[]).exactAs[String]
    if boosterType == "ART-GIFT_DOUBL" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], true,"",false)
    else
      throw("Error! Wrong item attached to double rewards!")
}

@Callable(i)
func finishRebirthItem(initTx: String, itemCode: String) = {
  #TODO CHECK IF ITEM IS ATTACHED, CHECK IT IN SC, AND THEN BURN ITEM
  if (size(i.payments) == 2 && i.payments[0].amount==1) then
    let assetId = i.payments[0].assetId.value()
    strict boosterType = invoke(getItemsAddress(),"checkArtefactDetails",[assetId.toBase58String()],[]).exactAs[String]
    #TODO CHANGE INTO CORRECT TYPE!!!!
    if boosterType == "ART-HWERASE" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], false, itemCode,false)
    
    else if boosterType == "ART-HWRESCUE" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], false, "",true)
    else if boosterType == "ART-GIFT_DOUBL" then 
      [
        Burn(assetId,1)
      ]++
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[1], true, "",false)
    else
      throw("Error! Wrong item attached ")
  else if (size(i.payments) == 1 ) then 
      finishRebirthInternal(initTx, i.caller.toString(),i.payments[0], false,"",false)
  else throw("Invalid payments")
}
@Verifier(tx)
func verify() = {
  if isTestEnv() then 
      sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)
  else
    let firstUser = base58'6TdaXEfhnjYquvPf3yV7MFxt2CbgFmaqsvGwkKfXtKi4'
    let secondUser = base58'7DsP2WaMLocbHuUxux7pbXRjTrrZ1TFQPsi5QumS3gr8'
    let thirdUser = base58'BpFWP3p3JgYrrP45xfrKzeMcWMEXoinj4FVPPkUiA8D3'

    let firstUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], firstUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], firstUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], firstUser)) then 1
        else 0
    let secondUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], secondUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], secondUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], secondUser)) then 1
        else 0
    let thirdUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], thirdUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[1], thirdUser)) then 1
        else if (sigVerify(tx.bodyBytes, tx.proofs[2], thirdUser)) then 1
        else 0
    let signaturesCount = firstUserSigned + secondUserSigned + thirdUserSigned

    match (tx) {
        case _ => signaturesCount >= 1
    }
} 
